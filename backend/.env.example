# Copy to .env in the project root (one level above backend/) and fill in.

# MongoDB Atlas connection string (include the database name after the host)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/ttps

MONGODB_DB=ttps
PORT=8000

# Google Gemini API key, required to read uploaded report images. Without it
# uploads return 503; everything else works.
GEMINI_API_KEY=

# Key for GET/POST /api/live/record, called every minute by an outside
# scheduler to record the live feed (generate with: openssl rand -hex 16).
# Without it that endpoint returns 503; the app still records while it is open.
LIVE_RECORD_KEY=

# The super admin, created at startup (or at the first sign-in) when the
# database has none. An existing user is never changed. Change the password on
# the Account tab afterwards. SUPERADMIN_NAME is optional (default "Super admin").
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME=

# Optional: Gemini model that reads the images, or a comma-separated list tried
# in order (default: MODELS in backend/extract.py)
# EXTRACTION_MODEL=
